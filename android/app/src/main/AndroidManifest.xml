<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- rtl_tcp и проверка обновлений -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- приём в фоне: сервис переднего плана «воспроизведение», уведомление, процессор и Wi-Fi не засыпают -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- USB-приёмник через OTG; без USB Host программа работает с rtl_tcp и тестовым сигналом -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".App"
        android:label="SDR4NOOB"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material"
        android:supportsRtl="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android предлагает открыть SDR4NOOB при подключении известного USB радиоприёмника (SDR) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_receivers" />
        </activity>

        <activity
            android:name=".ui.RadioActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="Радио" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="Настройки" />

        <activity
            android:name=".ui.GuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="Справка" />
        <service
            android:name=".radio.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
